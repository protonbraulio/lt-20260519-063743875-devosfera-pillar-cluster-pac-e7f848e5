          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-subtopics">Lead Generation Systems Subtopics</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-common-mistakes">Lead Generation Systems Common Mistakes</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-case-studies">Lead Generation Systems Case Studies</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-faq">Lead Generation Systems FAQ</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-glossary">Lead Generation Systems Glossary</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-checklist">Lead Generation Systems Checklist</a></li>
          <li><a href="https://protonbraulio.github.io/lt-20260519-063743875-devosfera-pillar-cluster-pac-e7f848e5/lead-generation-systems-methodology">Lead Generation Systems Methodology</a></li>
        </ul>
      </section>
      <div class="rounded border p-6 border-border/30">
        <h2 class="text-2xl font-semibold text-foreground">Next step</h2>
        <p class="mt-3 text-foreground/75">Talk to Devosfera Load Test 02 20260519-063743875 Pillar Cluster about lead generation systems.</p>
      </div>
    </section>
</main>
  <Footer />
</Layout>

<style>
  /* ── Hero title shimmer ── */
  .hero-title {
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 20%,
      var(--foreground) 35%,
      var(--foreground) 65%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 80%,
      var(--accent) 100%
    );
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    // ── Card glow follow cursor ──
    document.querySelectorAll<HTMLElement>(".card-glow").forEach(card => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });
  });
</script>
